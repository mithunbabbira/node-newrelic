{
  "name": "OtelDbClientSqlite3",
  "comment": "Canonicalizes SQLite library variants (better-sqlite3, node:sqlite, sqlite3) to a single 'sqlite' segment name.",
  "type": "db",
  "matcher": {
    "required_span_kinds": [
      "client"
    ],
    "required_attribute_keys": [
      "db.system.name",
      "server.address",
      "server.port"
    ],
    "attribute_conditions": {
      "db.system.name": {
        "expected": [
          "better-sqlite3",
          "node:sqlite",
          "sqlite3"
        ],
        "value": "sqlite"
      }
    }
  },
  "attributes": [
    {
      "key": "db.system.name",
      "target": "segment",
      "name": "product"
    },
    {
      "key": "db.namespace",
      "target": "segment",
      "name": "database_name"
    },
    {
      "key": "server.address",
      "target": "segment",
      "name": "host"
    },
    {
      "key": "server.port",
      "target": "segment",
      "name": "port_path_or_id"
    }
  ],
  "segment": {
    "statement": "db.query.text",
    "type": "db.system.name",
    "name": {
      "template": "Datastore/statement/${type}/${collection}/${operation}"
    }
  }
}
